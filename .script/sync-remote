#!/bin/python3

import os
import platform
import re
import selectors
import socket
import subprocess
import sys

from colorama import Fore, Style


RMCS_PATH = os.getenv("RMCS_PATH") or "/workspaces/RMCS"
INSTALL_DIR = os.path.join(RMCS_PATH, "rmcs_ws", "install")
DST_DIR = "ssh://remote//rmcs_install"
SOCKET_PATH = "/tmp/sync-remote"

SYNC_FLAG = b"Nothing to do:"
COLORED_SYNC_FLAG = (
    f"{Fore.LIGHTGREEN_EX}{Style.BRIGHT}Nothing to do{Style.RESET_ALL}:".encode("ascii")
)

_ARCH_MAP = {
    "x86_64": "amd64",
    "amd64": "amd64",
    "aarch64": "arm64",
    "arm64": "arm64",
}


def _print_usage():
    cross_dir = os.path.join(RMCS_PATH, "rmcs_ws", "install-cross-<arch>")
    print(f"""
Usage: sync-remote [--target-arch <arm64|amd64>]

Synchronize the local install directory to the remote /rmcs_install.

The source directory is selected from the target architecture stored in
~/.ssh/config (Host remote, "# RMCS_TARGET_ARCH=<arch>"):

  target == local arch : {INSTALL_DIR}
  target != local arch : {cross_dir}

Options:
  --target-arch <arm64|amd64>  Override the configured target architecture.
""")


def create_process(src_dir):
    command = [
        "unison",
        "-ignorearchives",
        "-auto",
        "-batch",
        "-repeat",
        "watch",
        "-times",
        src_dir,
        DST_DIR,
        "-force",
        src_dir,
        "-follow",
        "Name *",
    ]
    pipe_r, pipe_w = os.pipe()
    process = subprocess.Popen(
        command,
        stdout=pipe_w,
        stderr=pipe_w,
    )
    return process, pipe_r


def create_server():
    if os.path.exists(SOCKET_PATH):
        os.remove(SOCKET_PATH)

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCKET_PATH)
    server.listen()
    server.setblocking(False)

    return server


def finish_connection(conn: socket):
    try:
        conn.sendall(b"f")
    except:
        pass
    finally:
        conn.close()


def _local_arch():
    return _ARCH_MAP.get(platform.machine().lower())


def _read_target_arch():
    try:
        with open(os.path.expanduser("~/.ssh/config")) as f:
            config = f.read()
    except FileNotFoundError:
        return None

    block = re.search(r"Host remote\n(?:(?!Host ).+\n)*", config)
    if not block:
        return None

    match = re.search(r"#[ \t]*RMCS_TARGET_ARCH=(\S+)", block.group(0))
    return match.group(1) if match else None


def _parse_target_arch(argv):
    explicit = None

    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            _print_usage()
            sys.exit(0)
        if arg == "--target-arch":
            if i + 1 >= len(argv):
                sys.exit(
                    "Error: --target-arch requires a value (arm64 or amd64)."
                )
            explicit = argv[i + 1]
            i += 2
            continue
        if arg.startswith("--target-arch="):
            explicit = arg[len("--target-arch=") :]
        else:
            sys.exit(f"Error: Unknown argument '{arg}'.")
        i += 1

    if explicit is not None and explicit not in ("arm64", "amd64"):
        sys.exit(f"Error: Unsupported arch '{explicit}'. Use arm64 or amd64.")

    if explicit is not None:
        return explicit

    target = _read_target_arch()
    if target is None:
        return None
    if target not in ("arm64", "amd64"):
        print(
            "Warning: ignoring invalid RMCS_TARGET_ARCH="
            f"'{target}' in ~/.ssh/config.",
            file=sys.stderr,
        )
        return None
    return target


def _resolve_src_dir(target_arch):
    local_arch = _local_arch()

    if target_arch is None:
        print(
            "Warning: no RMCS_TARGET_ARCH configured for 'remote' in "
            "~/.ssh/config; syncing the native install directory. "
            "Run 'set-remote <remote_host> --arch <arm64|amd64>' to set it.",
            file=sys.stderr,
        )
        return INSTALL_DIR, local_arch

    if local_arch is None:
        print(
            "Warning: could not detect the local architecture; assuming it "
            f"differs from the target '{target_arch}'.",
            file=sys.stderr,
        )

    if target_arch == local_arch:
        return INSTALL_DIR, local_arch

    cross_dir = os.path.join(RMCS_PATH, "rmcs_ws", f"install-cross-{target_arch}")
    return cross_dir, local_arch


def _require_src_dir(src_dir, target_arch, local_arch):
    if os.path.isdir(src_dir):
        return

    lines = [f"Error: sync source not found: {src_dir}"]
    if target_arch is None:
        lines.append("  Build the workspace or set the arch first: build-rmcs")
    else:
        other = "amd64" if target_arch == "arm64" else "arm64"
        lines.append(
            f"  Target arch is {target_arch} (local arch: {local_arch}) "
            "but it has not been built."
        )
        lines.append(f"  Run: build-rmcs-cross --target-arch {target_arch}")
        lines.append(
            "  Or change the target arch: "
            f"set-remote <remote_host> --arch {other}"
        )
    sys.exit("\n".join(lines))


def main():
    target_arch = _parse_target_arch(sys.argv[1:])
    src_dir, local_arch = _resolve_src_dir(target_arch)
    _require_src_dir(src_dir, target_arch, local_arch)

    print(
        f"Syncing {src_dir} -> {DST_DIR} "
        f"(target: {target_arch or 'native'}, local: {local_arch or 'unknown'}).",
        flush=True,
    )

    selector = selectors.DefaultSelector()

    process, pipe_stdout = create_process(src_dir)
    selector.register(pipe_stdout, selectors.EVENT_READ, data=None)

    server = create_server()
    selector.register(server, selectors.EVENT_READ, data=None)

    clients = []
    ready = False

    try:
        while True:
            events = selector.select(timeout=1)
            for key, _ in events:
                if key.fileobj == server:
                    conn, _ = server.accept()
                    if ready:
                        finish_connection(conn)
                    else:
                        clients.append(conn)
                else:
                    stdout = os.read(pipe_stdout, 1024)
                    if stdout.startswith(SYNC_FLAG):
                        ready = True
                        stdout = COLORED_SYNC_FLAG + stdout[len(SYNC_FLAG) :]
                        for conn in clients:
                            finish_connection(conn)
                        clients = []
                    else:
                        ready = False
                    os.write(1, stdout)
            if process.poll() is not None:
                break
    except KeyboardInterrupt:
        try:
            process.wait()
        except KeyboardInterrupt:
            print("SIGINT sent twice, force quitting.")
            process.kill()
    finally:
        server.close()
        selector.close()
        if os.path.exists(SOCKET_PATH):
            os.unlink(SOCKET_PATH)


if __name__ == "__main__":
    main()
